DEEPGRAM_API_KEY=your_deepgram_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: language selected when the app starts.
# One of: en-US (default), ru, multi
# DEEPGRAM_LANGUAGE=ru

# Optional: opt out of Deepgram's Model Improvement Program (paid plans only).
# DEEPGRAM_MIP_OPT_OUT=true

# Optional: thinking effort for the analysis feature (a cost/quality knob).
# One of: low, medium (default), high, xhigh, max
# ANALYSIS_EFFORT=medium

# Optional: where the local web server listens.
# APP_HOST=127.0.0.1
# APP_PORT=8420
